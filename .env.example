# Copy to .env.nonprod for localhost + the hosted development backend,
# or .env.production for the production build.
VITE_SITE_URL=https://dev.liftlog.cc
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
VITE_ENABLE_TEST_PERSONAS=false

# Never add a secret/service-role key to a VITE_ variable. Vite values are public.
# The shared test-persona password belongs only in ignored .env.test-personas.
